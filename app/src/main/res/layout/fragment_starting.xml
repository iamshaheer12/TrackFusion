<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
  android:background="@color/spotify_background_black"
    android:layout_height="match_parent"
    tools:context=".view.StartingFragment">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.22" />
    <ImageView
        android:id="@+id/st_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/spotify_icon_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_guideline" />

    <TextView
        android:layout_marginTop="16dp"
        android:id="@+id/st_title_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Millions of songs\nFree on Spotify"
        android:textColor="@color/spotify_white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/st_logo"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent" />

    <Button

        android:id="@+id/st_sign_up_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Sign up free"
        android:textSize="@dimen/default_text_size"
        android:textStyle="normal"
        android:backgroundTint="@color/spotify_green"
        app:layout_constraintTop_toBottomOf="@+id/st_title_txt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.gms.common.SignInButton
        android:id="@+id/st_google_sign_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"


        app:iconGravity="start"
        android:textSize="@dimen/default_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/st_sign_up_btn"
        />
<!--    <com.google.android.material.button.MaterialButton-->
<!--        android:layout_marginTop="4dp"-->
<!--        android:id="@+id/st_facebook_sign_btn"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:textSize="@dimen/default_text_size"-->

<!--        android:layout_marginStart="12dp"-->
<!--        android:layout_marginEnd="12dp"-->
<!--        android:background="@drawable/custom_circular_border"-->
<!--        android:text="Continue with Facebook "-->
<!--        app:icon="@drawable/ic_facebook"-->
<!--        app:iconGravity="start"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/st_google_sign_btn"-->
<!--        tools:layout_editor_absoluteY="237dp" />-->
    <TextView
        android:clickable="true"
        android:layout_marginTop="12dp"
        android:id="@+id/st_sign_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:text="Log in"
        android:textSize="@dimen/default_text_size"
        android:textStyle="bold"
        android:textColor="@color/spotify_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/st_google_sign_btn"/>




</androidx.constraintlayout.widget.ConstraintLayout>