<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="16dp"
    android:id="@+id/search_artist_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/search_artist_image"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/atif"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout
        android:layout_width="0dp"
        app:layout_constraintStart_toEndOf="@+id/search_artist_image"
        app:layout_constraintTop_toTopOf="@+id/search_artist_image"
        app:layout_constraintBottom_toBottomOf="@+id/search_artist_image"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/search_artist_name"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/atif_aslam"
            android:textStyle="bold"
            android:textSize="@dimen/artist_text_size"

            android:textColor="@color/on_surface"
            app:layout_constraintTop_toTopOf="@+id/search_artist_image"
            app:layout_constraintBottom_toBottomOf="@+id/search_artist_image"
            app:layout_constraintStart_toEndOf="@+id/search_artist_image"

            />
        <TextView
            android:id="@+id/search_artist_artist"
            android:layout_width="165dp"
            android:layout_marginStart="8dp"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/artist"
            android:textSize="15sp"

            android:textColor="@color/on_surface_variant"
            app:layout_constraintTop_toTopOf="@+id/search_artist_name"
            app:layout_constraintStart_toEndOf="@+id/search_artist_image"


            />

    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>