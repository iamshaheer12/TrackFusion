<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:id="@+id/cr_item"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginEnd="12dp"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/cr_card_image"
        android:layout_width="170dp"
        android:layout_height="172dp"
        android:contentDescription="TODO"
        android:scaleType="centerCrop"
        android:src="@drawable/playlist_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView

        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/spotify_icon_white"/>


    <TextView
        android:id="@+id/cr_playlist_description"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:padding="4dp"
        android:text="Various Artistsjfdjhdhfdjhfjdfhjdhfjdjfhjdhfjdhfjdfhdjhfjdhffhj"
        android:ellipsize="end"
        android:textColor="@color/spotify_light_gray"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cr_card_image"/>





</androidx.constraintlayout.widget.ConstraintLayout>