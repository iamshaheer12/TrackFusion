<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/lib_constraint_layout"
    android:layout_width="match_parent"
    android:background="@color/spotify_background_black"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.LibraryFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/spotify_background_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Your custom view, like a logo or custom text -->
                <TextView
                    android:id="@+id/lib_custom_icon"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:clickable="true"
                    android:contentDescription="Custom Icon"
                    android:background="@drawable/circle_filled"

                    android:focusable="true"
                    android:gravity="center"
                    android:text="SH"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"

                    app:layout_constraintTop_toTopOf="parent" />
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/lib_profileImage"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="@drawable/circle_filled"
                    android:clickable="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:focusable="true"
                    android:gravity="center"


                    app:layout_constraintStart_toStartOf="parent"

                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/lib_toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="Your Library"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/heading_text_size"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/lib_custom_icon" />

                <!-- Icons on the right side -->

                <ImageView
                    android:id="@+id/lib_plus_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Plus Icon"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_add_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/lib_search_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Search Icon"
                    android:padding="8dp"
                    android:src="@drawable/baseline_search_24"
                    app:layout_constraintEnd_toStartOf="@+id/lib_plus_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/lib_radio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lib_toolbar_title">

                    <RadioButton
                        android:id="@+id/custom_radio_all"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:button="@null"
                        android:background="@drawable/custom_radio_selector"
                        android:gravity="center"
                        android:checked="true"
                        android:padding="8dp"
                        android:text="@string/all"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/custom_radio_playlist"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"

                        android:button="@null"
                        android:background="@drawable/custom_radio_selector"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/playlist"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/custom_radio_button_artist"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:button="@null"
                        android:background="@drawable/custom_radio_selector"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/artists"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />


                </RadioGroup>


                <!-- Additional custom view can be added here -->
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Title in the center -->


        </androidx.appcompat.widget.Toolbar>


    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_margin="16dp"

        android:id="@+id/lib_recycler_view"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout" />

    <ProgressBar
        android:id="@+id/library_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>






</androidx.constraintlayout.widget.ConstraintLayout>