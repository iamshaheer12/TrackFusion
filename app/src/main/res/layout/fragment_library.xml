<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lib_constraint_layout"
    android:layout_width="match_parent"
    android:background="@color/surface"
    android:layout_height="match_parent"
    tools:context=".view.LibraryFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_8">

                <LinearLayout
                    android:id="@+id/lib_linear_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/lib_custom_icon"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/circle_filled"
                        android:clickable="true"
                        android:contentDescription="Custom Icon"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="SH"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/lib_profileImage"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/circle_filled"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:scaleType="centerCrop"
                        android:visibility="visible"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/lib_toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Your Library"
                        android:textColor="@color/on_surface"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/lib_custom_icon" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/lib_plus_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:clickable="true"
                    android:contentDescription="Plus Icon"
                    android:focusable="true"
                    android:padding="@dimen/spacing_8"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_add_24"
                    app:layout_constraintBottom_toBottomOf="@id/lib_linear_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/lib_linear_layout"
                    app:tint="@color/on_surface_variant" />

                <ImageView
                    android:id="@+id/lib_search_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:clickable="true"
                    android:contentDescription="Search Icon"
                    android:focusable="true"
                    android:padding="@dimen/spacing_8"
                    android:src="@drawable/baseline_search_24"
                    app:layout_constraintBottom_toBottomOf="@id/lib_linear_layout"
                    app:layout_constraintEnd_toStartOf="@+id/lib_plus_icon"
                    app:layout_constraintTop_toTopOf="@id/lib_linear_layout"
                    app:tint="@color/on_surface_variant" />

                <RadioGroup
                    android:id="@+id/lib_radio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lib_linear_layout">

                    <RadioButton
                        android:id="@+id/custom_radio_all"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/custom_radio_selector"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:padding="@dimen/spacing_8"
                        android:text="@string/all"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/custom_radio_playlist"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:background="@drawable/custom_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="@dimen/spacing_8"
                        android:text="@string/playlist"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/custom_radio_button_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:background="@drawable/custom_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="@dimen/spacing_8"
                        android:text="@string/artists"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lib_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout" />

    <ProgressBar
        android:id="@+id/library_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/spotify_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
