<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@color/spotify_dark_gray">

    <ImageView
        android:id="@+id/notification_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:src="@drawable/atif" />

    <LinearLayout
        android:id="@+id/notification_linear_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is the"
            android:textSize="@dimen/heading_text_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/spotify_white" />

        <TextView
            android:id="@+id/notification_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is the"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/default_text_size"
            android:textStyle="bold"
            android:textColor="@color/spotify_light_gray" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notification_previous"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_previous_play" />

            <ImageView
                android:id="@+id/notification_play"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="24dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/notification_next"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="24dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_next_play" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>