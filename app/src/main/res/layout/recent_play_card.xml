<!--        android:src="@drawable/spotify_icon_white"/>-->


    <TextView
        android:id="@+id/rp_playlist_title"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:padding="4dp"
        android:text="Various Artistsjfdjhdhfdjhfjdfhjdhfjdjfhjdhfjdhfjdfhdjhfjdhffhj"
        android:ellipsize="end"
        android:textColor="@color/spotify_white"
