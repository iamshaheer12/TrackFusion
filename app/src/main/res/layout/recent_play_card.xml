<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rp_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_12"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/rp_image_container"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_rounded_artwork"
        android:clipToOutline="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/rp_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/playlist_poster" />

        <ImageView
            android:layout_width="@dimen/control_icon"
            android:layout_height="@dimen/control_icon"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_8"
            android:background="@drawable/bg_circle_green"
            android:padding="@dimen/spacing_6"
            android:src="@drawable/ic_play_arrow_24"
            tools:ignore="ContentDescription,HardcodedText" />

    </FrameLayout>

    <TextView
        android:id="@+id/rp_playlist_title"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:padding="0dp"
        android:text="Various Artistsjfdjhdhfdjhfjdfhjdhfjdjfhjdhfjdhfjdfhdjhfjdhffhj"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rp_image_container"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>
