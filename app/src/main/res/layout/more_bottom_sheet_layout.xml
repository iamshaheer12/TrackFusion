<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="@color/spotify_dark_gray"
    app:cardCornerRadius="8dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/more_bottom_sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_horizontal_rule_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/more_bottom_sheet_image"
            android:layout_width="70dp"
            android:layout_height="70dp"

            android:layout_marginTop="16dp"
            android:src="@drawable/atif"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/more_bottom_sheet_handle" />
        <LinearLayout
            android:id="@+id/more_bottom_sheet_linearLayout"
            android:layout_width="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/more_bottom_sheet_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/more_bottom_sheet_image"
            app:layout_constraintBottom_toBottomOf="@+id/more_bottom_sheet_image"
            >
            <TextView
                android:id="@+id/more_bottom_sheet_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/default_text_size"
                android:text="Bolna (From Kapoor  Sons (since 1921)) "
                android:textColor="@color/spotify_white"
                android:maxLines="2"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/more_bottom_sheet_song_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:text="Bolna (From Kapoor  Sons (since 1921)) "
                android:textColor="@color/spotify_light_gray"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/more_bottom_sheet_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/more_bottom_sheet_linearLayout" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>