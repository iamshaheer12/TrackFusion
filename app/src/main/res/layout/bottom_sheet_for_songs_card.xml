<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btm_sheet_song"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:layout_marginStart="@dimen/spacing_8"
    android:layout_marginEnd="@dimen/spacing_8"
    android:layout_marginBottom="@dimen/spacing_4"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:background="@color/now_playing_surface"
    app:cardBackgroundColor="@color/now_playing_surface"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="10dp"
    tools:context=".view.MainFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btm_sheet_song_image"
            android:layout_width="@dimen/artwork_small"
            android:layout_height="@dimen/artwork_small"
            android:layout_marginStart="@dimen/spacing_12"
            android:background="@drawable/bg_rounded_artwork"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/playlist_poster"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btm_sheet_song_like_btn"
            app:layout_constraintStart_toEndOf="@+id/btm_sheet_song_image"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btm_sheet_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:maxLines="1"
                android:text="Title"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/btm_sheet_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Raval dksjdksjdjdksjdksjdksjdn"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btm_sheet_song_like_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_4"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_unlike"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btm_sheet_song_play_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btm_sheet_song_play_btn"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_8"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_play_button_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <SeekBar
            android:id="@+id/mp_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progress="0"
            android:progressBackgroundTint="@color/on_surface_variant"
            android:progressTint="@color/spotify_green"
            android:secondaryProgressTint="@color/spotify_green"
            android:thumb="@null"
            android:splitTrack="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
