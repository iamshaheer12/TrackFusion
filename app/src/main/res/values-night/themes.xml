<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme1" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary color (used for the app's main branding) -->
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryVariant">@color/spotify_dark_green</item>

        <!-- Secondary color (used for buttons, switches, etc.) -->
        <item name="colorSecondary">@color/spotify_black</item>
        <item name="colorSecondaryVariant">@color/spotify_dark_gray</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/spotify_background_black</item>
        <item name="android:colorBackground">@color/spotify_background_black</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/spotify_white</item>
        <item name="android:textColorSecondary">@color/spotify_light_gray</item>
    </style>
</resources>
