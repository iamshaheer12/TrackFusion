<resources>
    <!-- Define your custom rounded corners style -->
    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/section_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.App.BodySecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>
</resources>
