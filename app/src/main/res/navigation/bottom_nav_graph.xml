<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/playlistFragment2"
        android:name="com.example.testprojectmusicplayer.view.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" >
        <argument
            android:name="albumId"
            app:argType="string"
            app:nullable="true"
            />
        <argument
            android:name="artistId"
            app:argType="string"
            app:nullable="true"
        />
        <action
            android:id="@+id/action_playlistFragment2_to_addSongFragment"
            app:destination="@id/addSongFragment" />

    </fragment>
    <fragment
        android:id="@+id/libSearchFragment2"
        android:name="com.example.testprojectmusicplayer.view.LibSearchFragment"
        android:label="fragment_lib_search"
        tools:layout="@layout/fragment_lib_search" />
    <fragment
        android:id="@+id/profileFragment2"
        android:name="com.example.testprojectmusicplayer.view.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment2_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment2_to_libraryFragment"
            app:destination="@id/libraryFragment" />
    </fragment>
    <fragment
        android:id="@+id/createPlaylistFragment2"
        android:name="com.example.testprojectmusicplayer.view.CreatePlaylistFragment"
        android:label="fragment_create_playlist"
        tools:layout="@layout/fragment_create_playlist" >
        <argument
            android:name="playlist"
            app:argType="com.example.testprojectmusicplayer.model.Album"
            app:nullable="true"
            />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.testprojectmusicplayer.view.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_searchScreen2Fragment"
            app:destination="@id/searchScreen2Fragment" />
    </fragment>
    <fragment
        android:id="@+id/searchScreen2Fragment"
        android:name="com.example.testprojectmusicplayer.view.SearchScreen2Fragment"
        android:label="fragment_search_screen2"
        tools:layout="@layout/fragment_search_screen2" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.testprojectmusicplayer.view.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_playlistFragment2"
            app:destination="@id/playlistFragment2" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment2"
            app:destination="@id/profileFragment2" />
    </fragment>
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.example.testprojectmusicplayer.view.LibraryFragment"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library" >
        <action
            android:id="@+id/action_libraryFragment_to_createPlaylistFragment2"
            app:destination="@id/createPlaylistFragment2" />
        <action
            android:id="@+id/action_libraryFragment_to_libSearchFragment2"
            app:destination="@id/libSearchFragment2" />
        <action
            android:id="@+id/action_libraryFragment_to_profileFragment2"
            app:destination="@id/profileFragment2" />
        <action
            android:id="@+id/action_libraryFragment_to_libPlaylistFragment"
            app:destination="@id/libPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/addSongFragment"
        android:name="com.example.testprojectmusicplayer.view.AddSongFragment"
        android:label="fragment_add_song"
        tools:layout="@layout/fragment_add_song" >
        <argument
            android:name="song"
            app:argType="string"/>
    </fragment>
    <fragment
        android:id="@+id/libPlaylistFragment"
        android:name="com.example.testprojectmusicplayer.view.LibPlaylistFragment"
        android:label="fragment_lib_playlist"
        tools:layout="@layout/fragment_lib_playlist" >
        <argument
            android:name="albumId"
            app:argType="string"
            app:nullable="true"
            />
        <argument
            android:name="artistId"
            app:argType="string"
            app:nullable="true"
            />
        <action
            android:id="@+id/action_libPlaylistFragment_to_addSongFragment"
            app:destination="@id/addSongFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.testprojectmusicplayer.view.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" >
        <action
            android:id="@+id/action_editProfileFragment_to_profileFragment2"
            app:destination="@id/profileFragment2" />
    </fragment>
</navigation>